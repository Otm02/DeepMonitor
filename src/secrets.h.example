// Copy this file to src/secrets.h and fill in your values.
// src/secrets.h is gitignored — never commit real credentials.

#ifndef SECRETS_H
#define SECRETS_H

#define WIFI_SSID     "your-wifi-ssid"
#define WIFI_PASS     "your-wifi-password"

// DeepMonitor server ingest endpoint (see docs/deployment.md)
#define WEBHOOK_URL   "http://192.168.1.100:8000/ingest"

// Control plane: device pulls its runtime config from here each connection.
// Use the per-device config endpoint; leave "" to disable config pull.
#define CONFIG_URL    "http://192.168.1.100:8000/api/devices/M5-DESK-01/config"

// Leave empty for the local server; set for Supabase REST (Bearer auth)
#define SUPABASE_APIKEY ""

#define DEVICE_ID     "M5-DESK-01"

#endif // SECRETS_H
